struct VertexInput
{
    position : vec3f,
    normal   : vec3f,
    uv       : vec2f,
}

struct VertexOutput
{
    [[sv_position]] position : vec4f,
    normal   : vec3f,
    uv       : vec2f,
}

struct CameraData
{
    viewProj : mat4f,
}

[[shader("vertex")]]
fn vertexMain(input : VertexInput, [[constant]] camera : CameraData) -> VertexOutput
{
    var mut output : VertexOutput;
    output.position = mul(camera.viewProj, vec4f(input.position, 1.0));
    output.normal = input.normal;
    output.uv = input.uv;
    return output;
}

[[shader("pixel")]]
fn fragmentMain(input : VertexOutput) -> vec4f
{
    var lightDir : vec3f = normalize(vec3f(0.3, -1.0, 0.2));
    var nDotL : f32 = max(0.0, dot(input.normal, lightDir));
    return vec4f(nDotL, nDotL, nDotL, 1.0);
}