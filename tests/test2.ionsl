// alias test

type vec3f = vector::<f32, 3>;
type vec3<T> = vector::<T, 3>;

struct VertexInput
{
    [[semantic("POSITION")]] position : vec3<f32>,
    [[semantic("NORMAL")]]   normal   : vec3<f32>,
    [[semantic("TEXCOORD", 0)]] uv    : vec3f,
}

struct VertexOutput
{
    [[semantic("SV_Position")]] position : vec3f,
    [[semantic("TEXCOORD", 1)]] normal   : vec3f,
    [[semantic("TEXCOORD", 2)]] uv       : vec3f,
}

struct CameraData
{
    viewProj : matrix::<f32, 4, 4>,
}

[[shader("vertex")]]
fn vertexMain(input : VertexInput, [[ion::mutable]] [[ion::constant]] camera : CameraData) -> VertexOutput
{
    var mut output : VertexOutput;

    output.position = mul(camera.viewProj, vector::<f32, 4>(input.position, 1.0));
    output.normal = input.normal;
    output.uv = input.uv;

    return output;
}

[[shader("pixel")]]
fn fragmentMain(input : VertexOutput) -> vector::<f32, 4>
{
    var lightDir : vector::<f32, 3> = normalize(vector::<f32, 3>(0.3, -1.0, 0.2));
    var nDotL : f32 = max(0.0, dot(input.normal, lightDir));

    return vector::<f32, 4>(nDotL, nDotL, nDotL, 1.0);
}
