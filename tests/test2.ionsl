struct ComputeParams
{
    count       : u32,
    multiplier  : u32,
    threshold   : f32,
}

fn classify(val : f32) -> i32
{
    if (val < 0.0)
    {
        return -1;
    }
    else if (val == 0.0)
    {
        return 0;
    }
    return 1;
}

[[shader("compute")]]
[[numthreads(64, 1, 1)]]
fn computeMain(
    [[sv_dispatchthreadid]] id : vec3<u32>,
    [[constant]] params : ComputeParams,
    [[storage]] [[access(readwrite)]] outputBuffer : u32[]
)
{
    if (id.x >= params.count)
    {
        return;
    }
    var mut accumulator : u32 = id.x * params.multiplier;
    for (var mut i : i32 = 0; i < 16; i += 1)
    {
        if (i % 2 == 0)
        {
            continue;
        }
        if (i > 10)
        {
            break;
        }
        accumulator += u32(i);
    }
    var mut step : u32 = 0u;
    while (step < 4u)
    {
        accumulator = (accumulator << 1u) ^ 0x0Fu;
        step += 1u;
    }
    accumulator &= 0xFFFFu;
    accumulator |= 0x0100u;
    outputBuffer[id.x] = accumulator;
}